# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=expense-tracker-backend
ENVIRONMENT=development        # development | staging | production
DEBUG=true
SECRET_KEY=change-me-before-deploying

# ── Database (Neon) ───────────────────────────────────────────────────────────
# Copy your connection string from: https://console.neon.tech → Project → Connection Details
# Use the asyncpg driver and always include ?sslmode=require for Neon.
#
# Format:
#   postgresql+asyncpg://<user>:<password>@<host>/<dbname>?sslmode=require
#
# Neon provides two endpoints:
#   Direct connection  — lower latency, use for migrations
#   Connection pooler  — use for the running app (handles serverless cold starts)
#
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
